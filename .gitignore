# Dependencies (recreated by `npm install`)
node_modules/

# Build output (recreated by `npm run build`, Vercel builds its own)
dist/
dist-ssr/
*.tsbuildinfo

# Environment variables and local overrides (may hold secrets)
.env
.env.*
*.local

# Vercel CLI project link (created by `vercel` / `vercel link`)
.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and AI-tool settings (personal, not part of the project)
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini
